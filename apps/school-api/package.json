{
  "name": "@edusync/school-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../../.env --import=tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db:migrate": "node --env-file=../../.env --import=tsx src/db/migrate.ts",
    "db:seed": "node --env-file=../../.env --import=tsx src/db/seed.ts"
  },
  "dependencies": {
    "@edusync/contracts": "workspace:*",
    "@edusync/api-docs": "workspace:*",
    "@fastify/cookie": "11.1.3",
    "@fastify/cors": "11.3.1",
    "@fastify/csrf-protection": "8.0.2",
    "@fastify/jwt": "10.2.4",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/session": "11.1.4",
    "argon2": "0.45.1",
    "better-auth": "1.7.10",
    "dotenv": "16.6.1",
    "fastify": "5.12.7",
    "nodemailer": "^10.1.2",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "tsx": "4.20.6",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
