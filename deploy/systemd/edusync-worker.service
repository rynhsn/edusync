[Unit]
Description=Edusync worker (antrean email, pesan, penagihan)
After=network-online.target postgresql.service edusync-api.service
Wants=network-online.target

[Service]
User=edusync
Group=edusync
WorkingDirectory=/opt/edusync/app/apps/worker
Environment=HOME=/opt/edusync
Environment=PATH=/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/opt/edusync/app/.env
ExecStart=/usr/local/bin/pnpm start
Restart=on-failure
RestartSec=5
# Batasi dampak bila ada celah: tidak boleh menaikkan hak akses dan sistem berkas selain /opt/edusync read-only.
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/opt/edusync

[Install]
WantedBy=multi-user.target
