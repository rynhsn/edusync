{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "edusync-api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@edusync/api",
        "start"
      ],
      "port": 4000
    },
    {
      "name": "edusync-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@edusync/web",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "edusync-worker",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@edusync/worker",
        "start"
      ],
      "port": 0
    }
  ]
}
