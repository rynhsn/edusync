NODE_ENV=development

PLATFORM_PORT=4001
PLATFORM_AUTH_URL=http://localhost:4001
PLATFORM_TRUSTED_ORIGINS=http://localhost:5174
PLATFORM_DATABASE_URL=postgres://edusync_platform:dev_platform_password@localhost:5433/edusync_platform
PLATFORM_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
PLATFORM_BOOTSTRAP_EMAIL=admin@platform.local
PLATFORM_BOOTSTRAP_PASSWORD=replace-with-a-private-password-at-least-12-characters
PLATFORM_BOOTSTRAP_ENABLED=false

# Optional Platform operator invitation email. Gmail requires an App Password; keep credentials private.
PLATFORM_PUBLIC_URL=http://localhost:5174
PLATFORM_SMTP_HOST=smtp.gmail.com
PLATFORM_SMTP_PORT=465
PLATFORM_SMTP_SECURE=true
PLATFORM_SMTP_USER=hi.edusync@gmail.com
PLATFORM_SMTP_PASSWORD=replace-with-a-private-gmail-app-password
PLATFORM_EMAIL_FROM=EduSync Platform <hi.edusync@gmail.com>

SCHOOL_PORT=4002
SCHOOL_DATABASE_URL=postgres://edusync_school:dev_school_password@localhost:5434/edusync_school
SCHOOL_AUTH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
SCHOOL_AUTH_URL=http://localhost:4002
SCHOOL_API_URL=http://localhost:4002
SCHOOL_PUBLIC_URL=http://localhost:5175
SCHOOL_TRUSTED_ORIGINS=http://localhost:5174,http://localhost:5175
SCHOOL_PROVISIONING_SECRET=replace-with-a-random-service-secret-at-least-32-characters

# Development-only School bootstrap. Creates one school, its organization, and its
# first accounts directly in the School database, because provisioning deliberately
# creates no user and admin activation is not implemented yet.
SCHOOL_BOOTSTRAP_ENABLED=false
SCHOOL_BOOTSTRAP_SCHOOL_NAME=SMA EduSync Demo
SCHOOL_BOOTSTRAP_SCHOOL_SLUG=sma-edusync-demo
SCHOOL_BOOTSTRAP_EMAIL=kepsek@sma-edusync-demo.local
SCHOOL_BOOTSTRAP_PASSWORD=replace-with-a-private-password-at-least-12-characters
# Optional second account, created with the read-only school_staff role.
SCHOOL_BOOTSTRAP_STAFF_EMAIL=staf@sma-edusync-demo.local
SCHOOL_BOOTSTRAP_STAFF_PASSWORD=replace-with-a-private-password-at-least-12-characters

WEB_PORT=5174
SCHOOL_WEB_PORT=5175
VITE_PLATFORM_API_URL=http://localhost:4001
VITE_SCHOOL_API_URL=http://localhost:4002
