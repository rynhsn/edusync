# Salin ke .env (tidak ikut git). Nilai di bawah hanya untuk pengembangan lokal.
NODE_ENV=development

# Pemilik skema (migrasi). Dipakai hanya oleh perintah db:migrate.
DATABASE_OWNER_URL=postgres://edusync:edusync_dev_only@localhost:5440/edusync
# Peran aplikasi, tunduk pada RLS. Dipakai semua request tenant.
DATABASE_URL=postgres://edusync_app:edusync_app_dev@localhost:5440/edusync
# Peran platform, melewati RLS. Hanya untuk konsol platform dan webhook.
DATABASE_PLATFORM_URL=postgres://edusync_platform:edusync_platform_dev@localhost:5440/edusync

API_PORT=4000

# Autentikasi (Better Auth). Ganti dengan nilai acak minimal 32 karakter; jangan dipakai di produksi.
AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
AUTH_URL=http://localhost:4000
TRUSTED_ORIGINS=http://localhost:3000

# Hanya untuk seed lokal (apps/api/scripts/seed-dev.ts).
DEV_SEED_PASSWORD=dev-seed-password-123

# Antrean pekerjaan (pg-boss). Dev memakai pemilik skema; produksi memakai peran khusus.
DATABASE_JOBS_URL=postgres://edusync:edusync_dev_only@localhost:5440/edusync
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=Edusync <noreply@edusync.test>

# Pembayaran. Penyedia dev tidak memakai uang dan dilarang di produksi.
PAYMENT_PROVIDER=dev
PAYMENT_DEV_SECRET=dev-only-payment-secret-do-not-use
WEB_URL=http://localhost:3000
# MIDTRANS_SERVER_KEY=
